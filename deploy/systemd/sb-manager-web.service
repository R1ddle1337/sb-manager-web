[Unit]
Description=sb-manager Go WebUI
After=network-online.target sb-manager-web-helper.service
Wants=network-online.target
Requires=sb-manager-web-helper.service

[Service]
Type=simple
ExecStart=/usr/local/bin/sb-web server --config /etc/sb-manager-web/config.json
Restart=on-failure
RestartSec=3s
User=sbweb
Group=sbweb
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/sb-manager-web /var/log/sb-manager-web /run/sb-manager-web

[Install]
WantedBy=multi-user.target
